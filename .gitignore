.env
node_modules/
.claude/settings.local.json
scripts/merged-admin.backup.*.json
.env.local
.env.*.local

# Exportaciones del histórico de precios (scripts/exportar-historico.mjs).
# NO van al repo: el repo es el sitio, así que todo lo commiteado se publica en comparalo.mx,
# y esto es nuestro histórico completo de precios. Además se regenera cuando haga falta: lo que
# de verdad lo conserva es scripts/historico-precios.json, que sí está versionado (400 días).
historico-export/

# Miniaturas del Centro de Control: ~4 MB que se rehacen en minutos con
# "node scripts/generar-miniaturas.mjs". Versionarlas metería un blob nuevo de 4 MB
# en cada corrida y, como el repo es el sitio, las publicaría en comparalo.mx.
scripts/centro-imagenes.json

# Credencial de la cuenta de servicio de Google para la analítica (GA4 + Search Console).
# Solo para correr scripts/analitica.mjs en la máquina; en GitHub vive como el secret
# GOOGLE_SERVICE_ACCOUNT_JSON. Como el repo es el sitio, commitearla la publicaría.
scripts/.google-sa.json
